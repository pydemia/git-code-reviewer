        <mxCell id="w-src-manifest" value="infra/kubernetes/worker/&#xa;deployment.yaml · service-account.yaml&#xa;network-policy.yaml&#xa;image digest + ConfigMap/Secret reference만 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#28734B;fontColor=#205D3D;fontSize=10;arcSize=8;" vertex="1" parent="w-source"><mxGeometry x="20" y="406" width="260" height="96" as="geometry"/></mxCell>

        <mxCell id="w-ci" value="CI/CD 실행 — build와 release만 수행하며 PR 분석은 하지 않음" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#E4F4E9;strokeColor=#28734B;fontColor=#205D3D;fontSize=13;fontStyle=1;arcSize=8;" vertex="1" parent="1"><mxGeometry x="370" y="100" width="330" height="540" as="geometry"/></mxCell>
        <mxCell id="w-orchestrator" value="[CI ORCHESTRATOR]&#xa;GitHub Actions / Jenkins&#xa;job metadata와 policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#28734B;fontColor=#205D3D;fontSize=10;arcSize=8;" vertex="1" parent="w-ci"><mxGeometry x="20" y="50" width="135" height="76" as="geometry"/></mxCell>
        <mxCell id="w-runner" value="[SELF-HOSTED RUNNER]&#xa;outbound job poll/status&#xa;checkout · inbound listener 없음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBF8;strokeColor=#28734B;fontColor=#205D3D;fontSize=10;fontStyle=1;arcSize=8;" vertex="1" parent="w-ci"><mxGeometry x="175" y="50" width="135" height="76" as="geometry"/></mxCell>
