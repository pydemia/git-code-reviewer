        <mxCell id="w-ci-identity" value="[CI IDENTITY]&#xa;OIDC / workload identity 권장&#xa;짧은 수명의 registry push + deploy 권한&#xa;GitHub App runtime key는 제외" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B95D0B;fontColor=#71400D;fontSize=10;arcSize=8;" vertex="1" parent="w-ci"><mxGeometry x="20" y="264" width="290" height="94" as="geometry"/></mxCell>
