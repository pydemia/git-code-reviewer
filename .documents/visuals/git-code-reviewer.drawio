        <mxCell id="w-baked" value="WORKER IMAGE에 포함&#xa;&#xa;compiled apps/worker + production dependency&#xa;고정된 Git CLI · Tree-sitter parser · 승인된 analyzer&#xa;CA bundle · non-root UID · entrypoint&#xa;label: source revision · version · SBOM digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3F2;strokeColor=#007F86;fontColor=#0B5559;fontSize=11;fontStyle=1;align=left;spacingLeft=14;arcSize=8;" vertex="1" parent="w-contract"><mxGeometry x="20" y="54" width="420" height="174" as="geometry"/></mxCell>
        <mxCell id="w-injected" value="CONTAINER 시작 / ROTATION 시 주입&#xa;&#xa;ConfigMap: GCR_GITHUB_*_URL · GCR_REDIS_HOST/PORT&#xa;GCR_DATABASE_HOST/NAME · GCR_OBJECT_BUCKET · GCR_MODEL_PROFILE&#xa;GCR_WORKER_CONCURRENCY · GCR_JOB_TIMEOUT_MS · GCR_LOG_LEVEL&#xa;Secret reference: GCR_GITHUB_APP_PRIVATE_KEY_FILE · GCR_DATABASE_PASSWORD_FILE&#xa;GCR_REDIS_PASSWORD_FILE · GCR_MODEL_TOKEN_FILE / workload identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EFFA;strokeColor=#2B5CA7;fontColor=#244D8C;fontSize=11;fontStyle=1;align=left;spacingLeft=14;arcSize=8;" vertex="1" parent="w-contract"><mxGeometry x="460" y="54" width="500" height="174" as="geometry"/></mxCell>
