    "findings": [
      {
        "id": "dcc0d59a-c180-4892-b30a-4c2931a0a017",
        "title": "Reference-block validation is no longer attached to BlockUpdateRequest",
        "problem": "`validate_block_update_type_rules` is defined as a standalone function, but neither `update_block` nor `preview_block` calls it. Consequently, `BlockUpdateRequest.model_validate(payload)` does not reject a reference block with an omitted or null `reference_id`.",
        "impact": "Invalid reference blocks are accepted through both service entry points, allowing malformed data or previews to proceed. The existing boundary tests expect `ValidationError` for these inputs.",
        "recommendation": "Restore the `@model_validator(mode=\"after\")` method on `BlockUpdateRequest` (returning `self`), or explicitly invoke the standalone validator immediately after model validation in every entry point. A model validator is preferable because both callers already construct this schema.",
        "category": "validation",
        "severity": "P2",
        "outcome": "violation",
        "confidence": "high",
        "followUp": "required",
