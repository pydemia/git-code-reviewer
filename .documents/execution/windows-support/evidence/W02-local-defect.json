        "evidenceAssessment": {
          "level": "source-confirmed",
          "rationale": "The source defines the cross-field rule only in an unreferenced function. The service source shows both entry points only call `BlockUpdateRequest.model_validate(payload)`. The fixed base attached the same rule as a Pydantic model validator, and the unchanged source tests require rejection in both paths. This also matches the applicable historical guidance from source 4f94ce45-2f0e-42e5-98b4-6ed2c2fde3e1 and its linked URL.",
          "conditions": [
            "A payload has `block_type` equal to `reference` and omits `reference_id`.",
