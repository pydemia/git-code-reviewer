NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgresql://git_code_reviewer:change-me@localhost:55432/git_code_reviewer
ARTIFACT_ROOT=./artifacts
WORKSPACE_ROOT=./tmp/workspaces
WORKER_CONCURRENCY=2
AUTH_MODE=development
SESSION_SECRET=replace-with-at-least-32-random-characters
DEV_USER_SUBJECT=local-reviewer
DEV_USER_NAME=Local Reviewer
DEV_USER_ROLE=admin
GITHUB_MODE=fixture
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app/private-key.pem
# GITHUB_API_BASE_URL=https://github.example.internal/api/v3
# GITHUB_WEB_BASE_URL=https://github.example.internal
# MODEL_MODE=openai-compatible
# MODEL_ENDPOINT=https://approved-model.example.internal/v1/
# MODEL_API_KEY=
# MODEL_NAME=
# CHAT_MODEL_MODE=openai-compatible
# CHAT_MODEL_ENDPOINT=https://approved-model.example.internal/v1/
# CHAT_MODEL_API_KEY=
# CHAT_MODEL_NAME=
# Alternative: use a deployment-owned ChatGPT account created by `codex login`.
# CHAT_MODEL_MODE=chatgpt-account
# CHAT_MODEL_NAME=<selected-codex-model-id>
# CHATGPT_ACCOUNT_HOME=/home/user/.codex
# CHATGPT_ACCOUNT_REFRESH_ENDPOINT=https://auth.openai.com/oauth/token
# CHATGPT_ACCOUNT_PROACTIVE_REFRESH_MINUTES=5
# CHAT_CONCURRENCY_LIMIT=2
# CHAT_HOURLY_LIMIT=30
# CHAT_SESSION_MESSAGE_LIMIT=200
# RETENTION_REPORT_DAYS=90
# RETENTION_CHAT_DAYS=30
# RETENTION_EVENT_LOG_HOURS=24
# RETENTION_ORPHAN_GRACE_HOURS=24
# RETENTION_DELETE_GRACE_HOURS=1
# RETENTION_BATCH_SIZE=500
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
