{
  "name": "@gcr/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts serve",
    "dev:server": "tsx watch src/index.ts serve",
    "migrate": "tsx src/index.ts migrate",
    "start": "node dist/index.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@gcr/contracts": "workspace:*",
    "@gcr/db": "workspace:*",
    "fastify": "^5.6.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
