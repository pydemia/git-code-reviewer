{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "minLength": 0,
      "maxLength": 52,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9][a-z0-9._:/-]*[a-z0-9]$",
          "not": {
            "pattern": "://"
          }
        },
        "digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": ["IfNotPresent", "Always"]
        }
      },
      "required": ["repository", "digest", "pullPolicy"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        },
        "required": ["name"]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "replicas": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[1-9][0-9]{0,4})?$"
    },
    "adminHostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[1-9][0-9]{0,4})?$"
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      },
      "required": ["existingSecret"]
    },
    "outboundTrust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": {
          "type": "string",
          "minLength": 0,
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": ["existingConfigMap", "key"]
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z_][a-z0-9_]{0,62}$"
        },
        "username": {
          "const": "gcr_keycloak"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingConfigMap": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "required": ["existingConfigMap", "key"]
        },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "initial": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["initial", "min", "max"]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "peakReplicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "connectionLimit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["peakReplicas", "connectionLimit"]
        }
      },
      "required": [
        "host",
        "port",
        "name",
        "username",
        "existingSecret",
        "passwordKey",
        "tls",
        "pool",
        "budget"
      ]
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 0,
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      },
      "required": ["existingSecret", "usernameKey", "passwordKey"]
    },
    "configurationRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^([0-9]+([.][0-9]+)?)(m|Ki|Mi|Gi|Ti)?$"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^([0-9]+([.][0-9]+)?)(m|Ki|Mi|Gi|Ti)?$"
            }
          },
          "required": ["cpu", "memory"]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^([0-9]+([.][0-9]+)?)(m|Ki|Mi|Gi|Ti)?$"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^([0-9]+([.][0-9]+)?)(m|Ki|Mi|Gi|Ti)?$"
            }
          },
          "required": ["cpu", "memory"]
        }
      },
      "required": ["requests", "limits"]
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "maxLength": 253
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 0,
            "maxLength": 253
          },
          "operator": {
            "enum": ["Exists", "Equal"]
          },
          "value": {
            "type": "string",
            "minLength": 0,
            "maxLength": 253
          },
          "effect": {
            "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute", ""]
          },
          "tolerationSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "required": []
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "peers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/networkPeer"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "trustedAddresses": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
                  },
                  {
                    "type": "string",
                    "format": "ipv6",
                    "pattern": ":"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])|[0-9A-Fa-f]*:[0-9A-Fa-f:]+/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
                  }
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": ["peers", "trustedAddresses"]
        },
        "adminPeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/networkPeer"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "monitoringPeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/networkPeer"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "databasePeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/networkPeer"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dnsPeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/networkPeer"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "peers": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/networkPeer"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["peers", "port"]
        }
      },
      "required": ["proxy", "adminPeers", "monitoringPeers", "databasePeers", "dnsPeers", "smtp"]
    }
  },
  "required": [
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "replicas",
    "hostname",
    "adminHostname",
    "tls",
    "outboundTrust",
    "database",
    "bootstrap",
    "configurationRevision",
    "resources",
    "nodeSelector",
    "tolerations",
    "networkPolicy"
  ],
  "definitions": {
    "networkPeer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "podLabels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 0,
                "maxLength": 63
              }
            }
          },
          "required": ["namespace", "podLabels"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])|[0-9A-Fa-f]*:[0-9A-Fa-f:]+/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
            }
          },
          "required": ["cidr"]
        }
      ]
    }
  }
}
