{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "server", "worker", "storage", "database", "retention"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "server": {
      "type": "object",
      "required": ["replicas", "port"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicas", "workspace"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "workspace": {
          "type": "object",
          "required": ["mode", "size"],
          "properties": {
            "mode": { "enum": ["emptyDir", "genericEphemeral"] },
            "size": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["backend"],
      "properties": { "backend": { "enum": ["pvc"] } }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "urlKey"],
      "properties": {
        "existingSecret": { "type": "string", "minLength": 1 },
        "urlKey": { "type": "string", "minLength": 1 }
      }
    },
    "retention": {
      "type": "object",
      "required": ["reportDays", "chatDays"],
      "properties": {
        "reportDays": { "type": "integer", "minimum": 1 },
        "chatDays": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

