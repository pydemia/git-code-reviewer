{
  "name": "git-code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @gcr/runtime build && pnpm --filter @gcr/web build",
    "build:packages": "pnpm --filter @gcr/contracts build && pnpm --filter @gcr/db build && pnpm --filter @gcr/github build && pnpm --filter @gcr/git-engine build && pnpm --filter @gcr/artifact-store build && pnpm --filter @gcr/review-contract build && pnpm --filter @gcr/analysis-engine build && pnpm build:clients",
    "dev": "pnpm build:packages && pnpm --parallel --filter @gcr/runtime --filter @gcr/web dev",
    "dev:server": "pnpm build:packages && pnpm --filter @gcr/runtime dev:server",
    "dev:web": "pnpm --filter @gcr/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate": "pnpm build:packages && pnpm --filter @gcr/runtime migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "build:clients": "pnpm --filter @gcr/client-contract build && pnpm --filter @gcr/client-core build && pnpm --filter @gcr/client-executors build",
    "pack:clients": "node scripts/client-packages.mjs",
    "build:cli": "pnpm build:clients && pnpm --filter @gcr/cli build",
    "pack:cli": "node scripts/cli-package.mjs",
    "test:saml-contract": "node scripts/saml-contract-fixtures.mjs",
    "smoke:saml-contract": "node scripts/saml-contract-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@node-saml/node-saml": "5.1.0",
    "@types/node": "^24.5.2",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^16.4.0",
    "playwright": "1.63.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^4.1.11",
    "xml-crypto": "6.1.2"
  }
}
