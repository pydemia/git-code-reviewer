{
  "name": "git-code-reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter @gcr/runtime build && pnpm --filter @gcr/web build",
    "build:packages": "pnpm --filter @gcr/contracts build && pnpm --filter @gcr/db build && pnpm --filter @gcr/github build",
    "dev": "pnpm build:packages && pnpm --parallel --filter @gcr/runtime --filter @gcr/web dev",
    "dev:server": "pnpm build:packages && pnpm --filter @gcr/runtime dev:server",
    "dev:web": "pnpm --filter @gcr/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate": "pnpm build:packages && pnpm --filter @gcr/runtime migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:packages && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
